{
  "openrpc": "1.3.2",
  "info": {
    "title": "APIculture JSON-RPC",
    "version": "1.0.0",
    "description": "JSON-RPC 2.0 API for the same apiary / hive / inspection domain as REST. POST a JSON body to the server URL with `Authorization: Bearer ak_…`. Method names match REST operationIds.",
    "license": { "name": "Apache 2.0" },
    "contact": {
      "name": "APIculture developer support",
      "url": "https://github.com/Andoral/APIculture/issues"
    }
  },
  "servers": [
    { "name": "Local sandbox", "url": "http://127.0.0.1:8787/rpc/v1" },
    { "name": "Sandbox", "url": "https://sandbox.api.apiculture.example/rpc/v1" },
    { "name": "Production", "url": "https://api.apiculture.example/rpc/v1" }
  ],
  "methods": [
    {
      "name": "listApiaries",
      "summary": "List apiaries",
      "description": "Returns apiaries visible to the authenticated account, newest first. Cursor-paginated.",
      "params": [
        { "name": "limit", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } },
        { "name": "cursor", "required": false, "schema": { "type": "string" } }
      ],
      "result": { "name": "page", "schema": { "$ref": "#/components/schemas/ApiaryPage" } },
      "examples": [
        {
          "name": "empty",
          "params": [{ "name": "limit", "value": 20 }],
          "result": { "name": "page", "value": { "data": [], "next_cursor": null } }
        }
      ]
    },
    {
      "name": "createApiary",
      "summary": "Create an apiary",
      "description": "Idempotent when `idempotency_key` is supplied.",
      "params": [
        { "name": "name", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 120 } },
        { "name": "location", "required": false, "schema": { "$ref": "#/components/schemas/GeoPoint" } },
        { "name": "idempotency_key", "required": false, "schema": { "type": "string" } }
      ],
      "result": { "name": "apiary", "schema": { "$ref": "#/components/schemas/Apiary" } },
      "examples": [
        {
          "name": "orchard",
          "params": [
            { "name": "name", "value": "Orchard apiary" },
            { "name": "location", "value": { "latitude": 55.7558, "longitude": 37.6173 } },
            { "name": "idempotency_key", "value": "5f2c7a4e-2f1e-4c1a-9d1e-0c1d2e3f4a5b" }
          ],
          "result": {
            "name": "apiary",
            "value": {
              "id": "ap_01J8Z5N6K8Q2X3W4V5B6C7D8E9",
              "name": "Orchard apiary",
              "location": { "latitude": 55.7558, "longitude": 37.6173 },
              "hive_count": 0,
              "created_at": "2026-09-30T16:00:00Z"
            }
          }
        }
      ]
    },
    {
      "name": "getApiary",
      "summary": "Get an apiary",
      "params": [{ "name": "apiary_id", "required": true, "schema": { "$ref": "#/components/schemas/ApiaryId" } }],
      "result": { "name": "apiary", "schema": { "$ref": "#/components/schemas/Apiary" } }
    },
    {
      "name": "updateApiary",
      "summary": "Update an apiary",
      "params": [
        { "name": "apiary_id", "required": true, "schema": { "$ref": "#/components/schemas/ApiaryId" } },
        { "name": "name", "required": false, "schema": { "type": "string" } },
        { "name": "location", "required": false, "schema": { "$ref": "#/components/schemas/GeoPoint" } }
      ],
      "result": { "name": "apiary", "schema": { "$ref": "#/components/schemas/Apiary" } }
    },
    {
      "name": "deleteApiary",
      "summary": "Delete an apiary",
      "description": "Fails with JSON-RPC error `-32009` if the apiary still contains hives.",
      "params": [{ "name": "apiary_id", "required": true, "schema": { "$ref": "#/components/schemas/ApiaryId" } }],
      "result": { "name": "ok", "schema": { "type": "boolean" } }
    },
    {
      "name": "listHives",
      "summary": "List hives",
      "params": [
        { "name": "apiary_id", "required": false, "schema": { "$ref": "#/components/schemas/ApiaryId" } },
        { "name": "status", "required": false, "schema": { "$ref": "#/components/schemas/HiveStatus" } },
        { "name": "limit", "required": false, "schema": { "type": "integer", "default": 20 } },
        { "name": "cursor", "required": false, "schema": { "type": "string" } }
      ],
      "result": { "name": "page", "schema": { "$ref": "#/components/schemas/HivePage" } }
    },
    {
      "name": "createHive",
      "summary": "Create a hive",
      "params": [
        { "name": "apiary_id", "required": true, "schema": { "$ref": "#/components/schemas/ApiaryId" } },
        { "name": "label", "required": true, "schema": { "type": "string" } },
        { "name": "queen_installed_at", "required": false, "schema": { "type": "string", "format": "date" } },
        { "name": "idempotency_key", "required": false, "schema": { "type": "string" } }
      ],
      "result": { "name": "hive", "schema": { "$ref": "#/components/schemas/Hive" } }
    },
    {
      "name": "getHive",
      "summary": "Get a hive",
      "params": [{ "name": "hive_id", "required": true, "schema": { "$ref": "#/components/schemas/HiveId" } }],
      "result": { "name": "hive", "schema": { "$ref": "#/components/schemas/Hive" } }
    },
    {
      "name": "listInspections",
      "summary": "List inspections of a hive",
      "params": [
        { "name": "hive_id", "required": true, "schema": { "$ref": "#/components/schemas/HiveId" } },
        { "name": "limit", "required": false, "schema": { "type": "integer", "default": 20 } },
        { "name": "cursor", "required": false, "schema": { "type": "string" } }
      ],
      "result": { "name": "page", "schema": { "$ref": "#/components/schemas/InspectionPage" } }
    },
    {
      "name": "createInspection",
      "summary": "Record an inspection",
      "params": [
        { "name": "hive_id", "required": true, "schema": { "$ref": "#/components/schemas/HiveId" } },
        { "name": "inspected_at", "required": true, "schema": { "type": "string", "format": "date-time" } },
        { "name": "queen_seen", "required": false, "schema": { "type": "boolean" } },
        { "name": "brood_frames", "required": false, "schema": { "type": "integer", "minimum": 0, "maximum": 20 } },
        { "name": "temperament", "required": false, "schema": { "type": "string", "enum": ["calm", "nervous", "aggressive"] } },
        { "name": "notes", "required": false, "schema": { "type": "string" } },
        { "name": "idempotency_key", "required": false, "schema": { "type": "string" } }
      ],
      "result": { "name": "inspection", "schema": { "$ref": "#/components/schemas/Inspection" } }
    },
    {
      "name": "listWebhooks",
      "summary": "List webhook endpoints",
      "params": [],
      "result": { "name": "endpoints", "schema": { "type": "array", "items": { "$ref": "#/components/schemas/WebhookEndpoint" } } }
    },
    {
      "name": "createWebhook",
      "summary": "Register a webhook endpoint",
      "description": "`secret` is returned only once.",
      "params": [
        { "name": "url", "required": true, "schema": { "type": "string", "format": "uri" } },
        {
          "name": "events",
          "required": true,
          "schema": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "enum": ["inspection.created", "hive.status_changed", "apiary.deleted"] }
          }
        }
      ],
      "result": { "name": "endpoint", "schema": { "$ref": "#/components/schemas/WebhookEndpointCreated" } }
    }
  ],
  "components": {
    "schemas": {
      "ApiaryId": { "type": "string", "pattern": "^ap_[0-9A-HJKMNP-TV-Z]{26}$" },
      "HiveId": { "type": "string", "pattern": "^hv_[0-9A-HJKMNP-TV-Z]{26}$" },
      "GeoPoint": {
        "type": "object",
        "required": ["latitude", "longitude"],
        "properties": { "latitude": { "type": "number" }, "longitude": { "type": "number" } }
      },
      "Apiary": {
        "type": "object",
        "required": ["id", "name", "hive_count", "created_at"],
        "properties": {
          "id": { "$ref": "#/components/schemas/ApiaryId" },
          "name": { "type": "string" },
          "location": { "$ref": "#/components/schemas/GeoPoint" },
          "hive_count": { "type": "integer" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "ApiaryPage": {
        "type": "object",
        "required": ["data", "next_cursor"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Apiary" } },
          "next_cursor": { "type": ["string", "null"] }
        }
      },
      "HiveStatus": { "type": "string", "enum": ["active", "queenless", "swarmed", "dead", "archived"] },
      "Hive": {
        "type": "object",
        "required": ["id", "apiary_id", "label", "status", "created_at", "updated_at"],
        "properties": {
          "id": { "$ref": "#/components/schemas/HiveId" },
          "apiary_id": { "$ref": "#/components/schemas/ApiaryId" },
          "label": { "type": "string" },
          "status": { "$ref": "#/components/schemas/HiveStatus" },
          "queen_installed_at": { "type": "string" },
          "last_inspected_at": { "type": ["string", "null"] },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" }
        }
      },
      "HivePage": {
        "type": "object",
        "required": ["data", "next_cursor"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Hive" } },
          "next_cursor": { "type": ["string", "null"] }
        }
      },
      "Inspection": {
        "type": "object",
        "required": ["id", "hive_id", "inspected_at", "created_at"],
        "properties": {
          "id": { "type": "string" },
          "hive_id": { "$ref": "#/components/schemas/HiveId" },
          "inspected_at": { "type": "string" },
          "queen_seen": { "type": "boolean" },
          "brood_frames": { "type": "integer" },
          "temperament": { "type": "string" },
          "notes": { "type": "string" },
          "created_at": { "type": "string" }
        }
      },
      "InspectionPage": {
        "type": "object",
        "required": ["data", "next_cursor"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Inspection" } },
          "next_cursor": { "type": ["string", "null"] }
        }
      },
      "WebhookEndpoint": {
        "type": "object",
        "required": ["id", "url", "events", "created_at"],
        "properties": {
          "id": { "type": "string" },
          "url": { "type": "string" },
          "events": { "type": "array", "items": { "type": "string" } },
          "created_at": { "type": "string" }
        }
      },
      "WebhookEndpointCreated": {
        "allOf": [
          { "$ref": "#/components/schemas/WebhookEndpoint" },
          { "type": "object", "required": ["secret"], "properties": { "secret": { "type": "string" } } }
        ]
      }
    }
  }
}
