---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const styles = [
	{ label: 'REST', href: `${base}/rest/quickstart/` },
	{ label: 'SOAP', href: `${base}/soap/quickstart/` },
	{ label: 'JSON-RPC', href: `${base}/rpc/quickstart/` },
	{ label: 'gRPC', href: `${base}/grpc/quickstart/` },
	{ label: 'GraphQL', href: `${base}/graphql/quickstart/` },
	{ label: 'WebSocket', href: `${base}/websocket/quickstart/` },
];
---

<div class="qs-picker" data-qs-picker>
	<button type="button" class="qs-picker__button" aria-expanded="false" aria-haspopup="menu" aria-controls="qs-picker-menu">
		Quickstart
		<span class="qs-picker__chevron" aria-hidden="true"></span>
	</button>
	<ul class="qs-picker__menu" id="qs-picker-menu" role="menu" hidden>
		{
			styles.map((item) => (
				<li role="none">
					<a class="qs-picker__link" role="menuitem" href={item.href}>
						{item.label}
					</a>
				</li>
			))
		}
	</ul>
</div>

<script>
	document.querySelectorAll('[data-qs-picker]').forEach((root) => {
		const button = root.querySelector('.qs-picker__button');
		const menu = root.querySelector('.qs-picker__menu');
		if (!(button instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;

		const setOpen = (open: boolean) => {
			button.setAttribute('aria-expanded', String(open));
			menu.hidden = !open;
			root.classList.toggle('is-open', open);
		};

		button.addEventListener('click', (event) => {
			event.stopPropagation();
			setOpen(menu.hasAttribute('hidden'));
		});
		document.addEventListener('click', (event) => {
			if (!root.contains(event.target as Node)) setOpen(false);
		});
		root.addEventListener('keydown', (event) => {
			if (!(event instanceof KeyboardEvent) || event.key !== 'Escape') return;
			setOpen(false);
			button.focus();
		});
	});
</script>

<style>
	.qs-picker {
		position: relative;
		display: inline-block;
		margin-inline-end: 1rem;
		margin-block-end: 1rem;
		vertical-align: middle;
	}
	.qs-picker__button {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		margin: 0;
		border: 0;
		border-radius: 999rem;
		padding: 0.6875rem 1.1875rem;
		font: inherit;
		font-weight: 600;
		line-height: 1.1875rem;
		cursor: pointer;
		color: var(--apiculture-on-accent, #3a2e00);
		background-color: var(--sl-color-text-accent);
	}
	.qs-picker__button:hover,
	.qs-picker.is-open .qs-picker__button {
		background-color: var(--sl-color-accent);
	}
	.qs-picker__chevron {
		width: 0.45rem;
		height: 0.45rem;
		border-right: 2px solid currentColor;
		border-bottom: 2px solid currentColor;
		transform: rotate(45deg) translateY(-1px);
	}
	.qs-picker.is-open .qs-picker__chevron {
		transform: rotate(-135deg) translateY(-1px);
	}
	.qs-picker__menu {
		position: absolute;
		z-index: 20;
		top: calc(100% + 0.4rem);
		left: 0;
		min-width: 12.5rem;
		margin: 0;
		padding: 0.35rem;
		list-style: none;
		border-radius: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-bg-nav);
		box-shadow: 0 8px 24px rgb(0 0 0 / 18%);
	}
	.qs-picker__link {
		display: block;
		border-radius: 0.5rem;
		padding: 0.45rem 0.75rem;
		color: var(--sl-color-white);
		text-decoration: none;
		font-weight: 600;
	}
	.qs-picker__link:hover {
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
	}

	:root[data-theme='light'] .qs-picker__button {
		background-color: var(--sl-color-accent);
	}
	:root[data-theme='light'] .qs-picker__button:hover,
	:root[data-theme='light'] .qs-picker.is-open .qs-picker__button {
		background-color: #e8b800;
	}
	:root[data-theme='light'] .qs-picker__link {
		color: var(--sl-color-text);
	}
	:root[data-theme='light'] .qs-picker__link:hover {
		background: var(--sl-color-gray-6);
		color: var(--sl-color-text);
	}
</style>
